{
  "name": "dsh-code-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "CodeIDE: file tree, editor and Git graph in the right Sidebar",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE-material-icon-theme",
    "vendor/",
    "scripts/"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "vscode",
    "code-viewer",
    "git-graph"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kingzhoudk/dsh-code-viewer.git"
  },
  "homepage": "https://github.com/Kingzhoudk/dsh-code-viewer#readme",
  "bugs": {
    "url": "https://github.com/Kingzhoudk/dsh-code-viewer/issues"
  }
}
